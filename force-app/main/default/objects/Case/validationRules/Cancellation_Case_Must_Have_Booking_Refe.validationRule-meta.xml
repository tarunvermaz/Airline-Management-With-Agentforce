<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Case_Must_Have_Booking_Refe</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
ISPICKVAL( Issue_Category__c , &quot;Cancellation&quot;),  
ISBLANK( Booking_Reference__c ) 
)</errorConditionFormula>
    <errorDisplayField>Booking_Reference__c</errorDisplayField>
    <errorMessage>Booking Reference is required for Cancellation cases.</errorMessage>
</ValidationRule>
