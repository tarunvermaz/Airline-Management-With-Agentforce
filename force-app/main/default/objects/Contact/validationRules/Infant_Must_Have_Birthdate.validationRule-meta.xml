<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Infant_Must_Have_Birthdate</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
ISPICKVAL( Passenger_Type__c , &quot;Infant&quot;), 
ISBLANK( Birthdate ) 
)</errorConditionFormula>
    <errorDisplayField>Birthdate</errorDisplayField>
    <errorMessage>Birthdate is required for passengers classified as Infant.</errorMessage>
</ValidationRule>
