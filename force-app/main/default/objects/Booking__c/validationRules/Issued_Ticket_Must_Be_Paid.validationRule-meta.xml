<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Issued_Ticket_Must_Be_Paid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Ticket_Status__c, &quot;Issued&quot;),
    NOT(ISPICKVAL(Payment_Status__c, &quot;Paid&quot;))
)</errorConditionFormula>
    <errorDisplayField>Ticket_Status__c</errorDisplayField>
    <errorMessage>A ticket can be Issued only when Payment Status is Paid.</errorMessage>
</ValidationRule>
