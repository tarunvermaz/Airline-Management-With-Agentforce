<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Confirmed_Booking_Must_Be_Paid</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Booking_Status__c, &quot;Confirmed&quot;),
 NOT( ISPICKVAL(Payment_Status__c, &quot;Paid&quot;))  )</errorConditionFormula>
    <errorDisplayField>Booking_Status__c</errorDisplayField>
    <errorMessage>A booking can be Confirmed only when Payment Status is Paid.</errorMessage>
</ValidationRule>
