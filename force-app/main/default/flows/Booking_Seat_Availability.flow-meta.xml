<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Booking_Status</name>
        <label>Check Booking Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Booking_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Booking_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Confirmed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_New_Confirmation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Flight_for_Seat_Update</targetReference>
            </connector>
            <label>Booking Confirmed</label>
        </rules>
        <rules>
            <name>Booking_Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Booking_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Flight_for_Seat_Increase</targetReference>
            </connector>
            <label>Booking Cancelled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Is_New_Confirmation</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!$Record.Booking_Status__c}, &quot;Confirmed&quot;),
    NOT(ISPICKVAL({!$Record__Prior.Booking_Status__c}, &quot;Confirmed&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>New_Available_Seats_After_Cancellation2</name>
        <dataType>Number</dataType>
        <expression>{!Get_Flight_for_Seat_Increase.Available_Seats__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>New_Available_Seats_After_Confirmation</name>
        <dataType>Number</dataType>
        <expression>{!Get_Flight_for_Seat_Update.Available_Seats__c}-1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Booking Seat Availability {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Seat Availability</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Flight_for_Seat_Increase</name>
        <label>Get Flight for Seat Increase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Increase_Available_Seats</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Flight__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Flight__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Flight_for_Seat_Update</name>
        <label>Get Flight for Seat Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decrease_Available_Seats</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Flight__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Flight__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Decrease_Available_Seats</name>
        <label>Decrease Available Seats</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Flight__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Available_Seats__c</field>
            <value>
                <elementReference>New_Available_Seats_After_Confirmation</elementReference>
            </value>
        </inputAssignments>
        <object>Flight__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Increase_Available_Seats</name>
        <label>Increase Available Seats</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Flight__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Available_Seats__c</field>
            <value>
                <elementReference>New_Available_Seats_After_Cancellation2</elementReference>
            </value>
        </inputAssignments>
        <object>Flight__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Booking_Status</targetReference>
        </connector>
        <object>Booking__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
